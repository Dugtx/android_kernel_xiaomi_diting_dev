. ${ROOT_DIR}/${KERNEL_DIR}/build.config.gki.aarch64

POST_DEFCONFIG_CMDS="check_defconfig && update_docker_basic_config"

function update_docker_basic_config() {
    local fragment="${ROOT_DIR}/${KERNEL_DIR}/arch/arm64/configs/docker_basic.fragment"

    ${KERNEL_DIR}/scripts/kconfig/merge_config.sh \
        -m -r -O "${OUT_DIR}" \
        "${OUT_DIR}/.config" "${fragment}"

    (cd "${OUT_DIR}" && \
        make ${CC_LD_ARG} O="${OUT_DIR}" olddefconfig)

    while IFS= read -r option; do
        case "${option}" in
            CONFIG_*=y)
                grep -qxF "${option}" "${OUT_DIR}/.config" || {
                    echo "ERROR: Docker Basic option was not resolved: ${option}" >&2
                    return 1
                }
                ;;
        esac
    done < "${fragment}"
}
